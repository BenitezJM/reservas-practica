<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Tabla complejo -->
    <changeSet id="001-crear-tabla-complejo" author="reservas">
        <createTable tableName="complejo">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_complejo"/>
            </column>
            <column name="nombre" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="hora_apertura" type="TIME">
                <constraints nullable="false"/>
            </column>
            <column name="hora_cierre" type="TIME">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Tabla cancha -->
    <changeSet id="001-crear-tabla-cancha" author="reservas">
        <createTable tableName="cancha">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_cancha"/>
            </column>
            <column name="complejo_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_cancha_complejo"
                             references="complejo(id)"/>
            </column>
            <column name="nombre" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="activa" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="cancha" indexName="idx_cancha_complejo_id">
            <column name="complejo_id"/>
        </createIndex>
    </changeSet>

    <!-- Tabla tarifa_horaria -->
    <changeSet id="001-crear-tabla-tarifa-horaria" author="reservas">
        <createTable tableName="tarifa_horaria">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_tarifa_horaria"/>
            </column>
            <column name="cancha_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_tarifa_cancha"
                             references="cancha(id)"/>
            </column>
            <column name="precio" type="DECIMAL(10, 2)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="tarifa_horaria" indexName="idx_tarifa_cancha_id">
            <column name="cancha_id"/>
        </createIndex>
    </changeSet>

    <!-- Tabla usuario -->
    <changeSet id="001-crear-tabla-usuario" author="reservas">
        <createTable tableName="usuario">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_usuario"/>
            </column>
            <column name="email" type="VARCHAR(150)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_usuario_email"/>
            </column>
            <column name="nombre" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="rol" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Tabla reserva -->
    <changeSet id="001-crear-tabla-reserva" author="reservas">
        <createTable tableName="reserva">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_reserva"/>
            </column>
            <column name="cancha_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_reserva_cancha"
                             references="cancha(id)"/>
            </column>
            <column name="usuario_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_reserva_usuario"
                             references="usuario(id)"/>
            </column>
            <column name="fecha_inicio" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="fecha_fin" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="estado" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="precio_final" type="DECIMAL(10, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="creada_en" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="reserva" indexName="idx_reserva_cancha_id">
            <column name="cancha_id"/>
        </createIndex>
        <createIndex tableName="reserva" indexName="idx_reserva_usuario_id">
            <column name="usuario_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
